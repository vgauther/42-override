#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>

void log_wrapper(FILE *logfp, char *fmt, char *arg)
{
    char buf[0x110];                         /* -0x110 */

    strcpy(buf, fmt);                        /* fmt = constant from main (safe) */
    snprintf(buf + strlen(buf),
             0xfe - strlen(buf),
             arg);                           /* arg = argv[1] used AS FORMAT -> vuln */
    buf[strcspn(buf, "\n")] = 0;             /* 0x400d4c = "\n" */
    fprintf(logfp, "LOG: %s\n", buf);              /* 0x400d4e, writes buf to the log file */
}

int main(int argc, char **argv)
{
    char  dest[?];        /* -0x70 */
    char  c = 0xff;       /* -0x71 */
    int   fd = -1;        /* -0x78 */
    FILE *logfp;          /* -0x88 */
    FILE *src;            /* -0x80 */

    if (argc != 2)
        printf("...", argv[0]);              /* 0x400d57 usage (no exit) */

    logfp = fopen("./backups/.log", "w");             /* path 0x400d6d, mode 0x400d6b */
    if (logfp == NULL) {
        printf("...", "...");                /* 0x400d7c */
        exit(1);
    }

    log_wrapper(logfp, "Starting back up: ", argv[1]);      /* 0x400d96 -> snprintf(argv[1]) fires HERE */

    src = fopen(argv[1], "r");               /* 0x400da9 = "r" */
    if (src == NULL) {
        printf("...", argv[1]);              /* 0x400d7c */
        exit(1);
    }

    /* dest = prefix + argv[1] */
    memcpy(dest, "./backups/", 11);                 /* 0x400dab, 8+2+1 bytes */
    strncat(dest, argv[1], 0x63 - strlen(dest));   /* 99 - len */

    fd = open(dest, 0xc1, 0x1b0);            /* O_WRONLY|O_CREAT|O_EXCL, mode 0660 */
    if (fd < 0) {
        printf("ERROR: Failed to open %s%s\n", argv[1]);              /* 0x400db6 */
        exit(1);
    }

    /* copy src -> dest byte by byte until EOF */
    c = fgetc(src);
    while ((unsigned char)c != 0xff) {
        write(fd, &c, 1);
        c = fgetc(src);
    }

    log_wrapper(logfp, "...", argv[1]);      /* 0x400dd2 */
    fclose(src);
    close(fd);
    return 0;
}