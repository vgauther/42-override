#include <sys/wait.h>
#include <sys/ptrace.h>
#include <sys/prctl.h>

int main(void)
{
    char buf[128];        /* esp+0x20, zeroed: rep stos 0x20 dwords = 128 */
    int  status;          /* esp+0x1c */
    int  sc;              /* esp+0xa8 */
    pid_t pid;            /* esp+0xac */

    pid = fork();
    memset(buf, 0, sizeof(buf));
    sc = 0;
    status = 0;

    if (pid == 0)
    {
        /* --- child --- */
        prctl(PR_SET_PDEATHSIG, SIGHUP);     /* prctl(1, 1) */
        ptrace(PTRACE_TRACEME, 0, 0, 0);     /* ptrace(0,0,0,0) */
        puts("Give me some shellcode, k");   /* 0x8048903 */
        gets(buf);                           /* <-- overflow, no bounds */
    }
    else
    {
        /* --- parent: traces the child --- */
        wait(&status);

        if ((status & 0x7f) == 0)            /* not killed by a signal */
        {
            puts("child is exiting...");                     /* 0x804891d */
        }
        else if ((signed char)(((status & 0x7f) + 1) >> 1) > 0)  /* WIFSIGNALED */
        {
            /* read the syscall number the child was attempting (orig_eax @ 0x2c) */
            sc = ptrace(PTRACE_PEEKUSER, pid, 0x2c, 0);   /* ptrace(3, pid, 0x2c, 0) */
            if (sc == 0xb)                   /* 11 == SYS_execve (x86-32) */
            {
                puts("no exec() for you");                 /* 0x8048931 */
                kill(pid, 9);
            }
        }
    }
    return (0);
}